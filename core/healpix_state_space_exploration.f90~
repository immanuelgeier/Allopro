subroutine read_odf_lib(odf_lib)

    implicit none

    type(odf_lib_type), intent(inout) :: odf_lib

    integer :: iodf
    integer :: ipix
    integer :: iobj
    integer :: unit
    integer :: ios

    integer :: nside_file
    integer :: npix_file
    integer :: nobj_file

    character(len=256) :: filename
    character(len=256) :: line

    character(len=32) :: dummy1
    character(len=32) :: dummy2


    !=========================================================
    ! Alle ODFs einlesen
    !=========================================================

    do iodf = 1, odf_lib%n_odf

        filename = trim(odf_lib%odf(iodf)%odf_name)//".txt"

        write(0,*) 'Reading ODF: ', trim(filename)


        !-----------------------------------------------------
        ! Datei öffnen
        !-----------------------------------------------------

        open(newunit=unit, &
             file=trim(filename), &
             status='old', &
             action='read', &
             iostat=ios)

        if (ios /= 0) then

            write(0,*) 'ERROR: could not open ODF file: ', &
                       trim(filename)

            stop

        end if


        !=====================================================
        ! Header
        !=====================================================

        !-----------------------------------------------------
        ! # nside <value>
        !-----------------------------------------------------

        read(unit,'(A)',iostat=ios) line

        if (ios /= 0) then

            write(0,*) 'ERROR reading nside header'
            write(0,*) '  file = ',trim(filename)

            close(unit)
            stop

        end if


        read(line,*,iostat=ios) dummy1, dummy2, nside_file

        if (ios /= 0) then

            write(0,*) 'ERROR parsing nside header'
            write(0,*) '  line = ',trim(line)

            close(unit)
            stop

        end if


        !-----------------------------------------------------
        ! # npix <value>
        !-----------------------------------------------------

        read(unit,'(A)',iostat=ios) line

        if (ios /= 0) then

            write(0,*) 'ERROR reading npix header'
            write(0,*) '  file = ',trim(filename)

            close(unit)
            stop

        end if


        read(line,*,iostat=ios) dummy1, dummy2, npix_file

        if (ios /= 0) then

            write(0,*) 'ERROR parsing npix header'
            write(0,*) '  line = ',trim(line)

            close(unit)
            stop

        end if


        !-----------------------------------------------------
        ! # nobj <value>
        !-----------------------------------------------------

        read(unit,'(A)',iostat=ios) line

        if (ios /= 0) then

            write(0,*) 'ERROR reading nobj header'
            write(0,*) '  file = ',trim(filename)

            close(unit)
            stop

        end if


        read(line,*,iostat=ios) dummy1, dummy2, nobj_file

        if (ios /= 0) then

            write(0,*) 'ERROR parsing nobj header'
            write(0,*) '  line = ',trim(line)

            close(unit)
            stop

        end if


        !=====================================================
        ! Konsistenzchecks
        !=====================================================

        if (nside_file /= odf_lib%odf(iodf)%nside) then

            write(0,*) 'ERROR: nside mismatch'
            write(0,*) '  file = ',nside_file
            write(0,*) '  ODF  = ',odf_lib%odf(iodf)%nside
            write(0,*) '  file = ',trim(filename)

            close(unit)
            stop

        end if


        if (npix_file /= odf_lib%odf(iodf)%npix) then

            write(0,*) 'ERROR: npix mismatch'
            write(0,*) '  file = ',npix_file
            write(0,*) '  ODF  = ',odf_lib%odf(iodf)%npix
            write(0,*) '  file = ',trim(filename)

            close(unit)
            stop

        end if


        if (nobj_file /= size(odf_lib%odf(iodf)%hist,2)) then

            write(0,*) 'ERROR: nobj mismatch'
            write(0,*) '  file = ',nobj_file
            write(0,*) '  ODF  = ', &
                       size(odf_lib%odf(iodf)%hist,2)
            write(0,*) '  file = ',trim(filename)

            close(unit)
            stop

        end if


        !=====================================================
        ! Histogramm
        !
        ! Die vorhandene Schreib-Routine hat:
        !
        !   ipix = 1 ... npix
        !
        ! geschrieben.
        !
        ! Die interne Struktur ist:
        !
        !   hist(0:npix-1,nobj)
        !
        ! Daher:
        !
        !   erste Datei-Zeile  -> hist(0,:)
        !   letzte Datei-Zeile -> hist(npix-1,:)
        !=====================================================

        do ipix = 1, npix_file

            read(unit,*,iostat=ios) &
                (odf_lib%odf(iodf)%hist(ipix,iobj), &
                 iobj=1,nobj_file)

            if (ios /= 0) then

                write(0,*) 'ERROR reading histogram'
                write(0,*) '  file  = ',trim(filename)
                write(0,*) '  line  = ',ipix
                write(0,*) '  pixel = ',ipix

                close(unit)
                stop

            end if

        end do


        close(unit)


        !=====================================================
        ! Kontrolle
        !=====================================================

        write(0,*) '  nside  = ',odf_lib%odf(iodf)%nside
        write(0,*) '  npix   = ',odf_lib%odf(iodf)%npix
        write(0,*) '  nobj   = ',nobj_file
        write(0,*) '  counts = ',sum(odf_lib%odf(iodf)%hist)

    end do


    write(0,*) 'All ODFs successfully loaded.'


end subroutine read_odf_lib




subroutine write_odf_analysis_text(odf_lib)
    implicit none

    type(odf_lib_type), intent(in) :: odf_lib

    integer :: iodf, iobj, ilevel, i
    integer :: unit, nobj
    character(len=256) :: filename

    do iodf = 1, odf_lib%n_odf
        if (.not. allocated(odf_lib%odf(iodf)%analysis)) cycle

        ! Dateiname z. B. "state_0001_lag_000_analysis.txt"
        filename = trim(odf_lib%odf(iodf)%odf_name) // "_analysis.txt"

        open(newunit=unit, file=trim(filename), status="replace", action="write")

        nobj = size(odf_lib%odf(iodf)%analysis, 1)

        write(unit, '(A)') "# ========================================================"
        write(unit, '(A, A)') "# ODF Analysis Data for: ", trim(odf_lib%odf(iodf)%odf_name)
        write(unit, '(A, I8)') "# State: ", odf_lib%odf(iodf)%state
        write(unit, '(A, I8)') "# Lag:   ", odf_lib%odf(iodf)%lag
        write(unit, '(A, I8)') "# Nobj:  ", nobj
        write(unit, '(A, I8)') "# Nlevel:", odf_lib%nlevel
        write(unit, '(A)') "# ========================================================"

        do iobj = 1, nobj
            do ilevel = 1, odf_lib%nlevel
                associate(an => odf_lib%odf(iodf)%analysis(iobj, ilevel))

                    write(unit, '(A, I6, A, I3, A, I3, A, I6, A, I6, A, ES18.10)') &
                        "OBJ:", iobj, " LVL:", ilevel, &
                        " HEALPix_LVL:", an%level, " NSIDE:", an%nside, " NPIX:", an%npix, &
                        " ENTROPY:", an%entropy

                    ! Maxima schreiben
                    write(unit, '(A, I5)', advance='no') "  MAXIMA_COUNT:", an%nmax
                    if (an%nmax > 0 .and. allocated(an%maxima_pix)) then
                        write(unit, '(A)', advance='no') " | PIX:"
                        do i = 1, an%nmax
                            write(unit, '(I8)', advance='no') an%maxima_pix(i)
                        end do
                        write(unit, '(A)', advance='no') " | VAL:"
                        do i = 1, an%nmax
                            write(unit, '(I8)', advance='no') an%maxima_value(i)
                        end do
                    end if
                    write(unit, *) ! Zeilenumbruch

                    ! Basins / Einzugsgebiete schreiben
                    write(unit, '(A, I5)', advance='no') "  BASIN_COUNT: ", an%nbasin
                    if (an%nbasin > 0 .and. allocated(an%basin_pix)) then
                        write(unit, '(A)', advance='no') " | PIX:"
                        do i = 1, an%nbasin
                            write(unit, '(I8)', advance='no') an%basin_pix(i)
                        end do
                        write(unit, '(A)', advance='no') " | COUNTS:"
                        do i = 1, an%nbasin
                            write(unit, '(I8)', advance='no') an%basin_counts(i)
                        end do
                    end if
                    write(unit, *) ! Zeilenumbruch

                end associate
            end do
        end do

        close(unit)
    end do

end subroutine write_odf_analysis_text

subroutine init_odf_lib(cv_p,odf_lib, lifting_plan, max_lag, basis_index, nlevel, nobj,prefix_odf,path_odf)

    implicit none

    type(odf_lib_type), intent(out) :: odf_lib
    type(lifting_plan_type), intent(in) :: lifting_plan
    type(cv_plan) :: cv_p

    integer, intent(in) :: max_lag
    integer, intent(in) :: basis_index
    integer, intent(in) :: nobj, nlevel

    integer :: istate, ilag, iodf, ilevel, iobj
    integer :: npix, nside, lvl_nside, lvl_npix
    character(len=*),intent(in) :: prefix_odf,path_odf

    nside = 2**(nlevel-1)
    npix  = 12 * 4**(nlevel-1)

   
    
    odf_lib%max_lag = max_lag
    odf_lib%n_odf   = size(lifting_plan%istates) * (max_lag + 1)
    write(0,*) odf_lib%n_odf, lifting_plan%istates

    allocate(odf_lib%odf(odf_lib%n_odf))
    allocate(odf_lib%c2_symmetry(nobj))
    allocate(odf_lib%entropy(nobj, max_lag+1, nlevel))

    odf_lib%entropy = 0.0_8
    odf_lib%nlevel  = nlevel
    odf_lib%c2_symmetry = .false.
    
    write(0,*) 'npix odf', npix, lifting_plan%istates,nobj
    do iobj=1,nobj/2
    if(  trim(cv_p%object(iobj)%point_group)=='C2') then
    	odf_lib%c2_symmetry(iobj*2)=.true.
    end if
    write(0,*)iobj, cv_p%object(iobj)%point_group,odf_lib%c2_symmetry(iobj*2)
    end do
    !pause

    iodf = 0
    do istate = 1, size(lifting_plan%istates)
        do ilag = 0, max_lag
            iodf = iodf + 1

          write(odf_lib%odf(iodf)%odf_name, &
    '(*(A), "state_", I4.4, "_lag_", I3.3)') &
    trim(prefix_odf), "/", trim(path_odf), &
    lifting_plan%istates(istate), ilag
                
                
                

            odf_lib%odf(iodf)%state       = lifting_plan%istates(istate)
            odf_lib%odf(iodf)%lag         = ilag
            odf_lib%odf(iodf)%basis_index = basis_index
            odf_lib%odf(iodf)%nside       = nside
            odf_lib%odf(iodf)%npix        = npix

            ! 1. Histogramm-Array allokieren
            allocate(odf_lib%odf(iodf)%hist(npix, nobj))
            odf_lib%odf(iodf)%hist = 0

            ! 2. NEU: analysis-Array allokieren (Dimensionen: nobj, nlevel)
            allocate(odf_lib%odf(iodf)%analysis(nobj, nlevel))

            ! 3. Pre-Initialisierung der Level-Metadaten
            do ilevel = 1, nlevel
                lvl_nside = 2**(ilevel - 1)
                lvl_npix  = 12 * 4**(ilevel - 1)

                do iobj = 1, nobj
                    odf_lib%odf(iodf)%analysis(iobj, ilevel)%level   = ilevel
                    odf_lib%odf(iodf)%analysis(iobj, ilevel)%nside   = lvl_nside
                    odf_lib%odf(iodf)%analysis(iobj, ilevel)%npix    = lvl_npix
                    odf_lib%odf(iodf)%analysis(iobj, ilevel)%entropy = 0.0d0
                    odf_lib%odf(iodf)%analysis(iobj, ilevel)%nmax    = 0
                    odf_lib%odf(iodf)%analysis(iobj, ilevel)%nbasin  = 0
                end do
            end do

        end do
    end do
    
     
   ! odf_lib%odf(:)%odf_name=odf_name

end subroutine init_odf_lib





subroutine set_odf_analysis_maxima(an, nmax, pix, values)
    implicit none
    type(odf_level_analysis_type), intent(inout) :: an
    integer, intent(in) :: nmax
    integer, intent(in) :: pix(nmax)
    integer, intent(in) :: values(nmax)

    an%nmax = nmax
    if (allocated(an%maxima_pix))   deallocate(an%maxima_pix)
    if (allocated(an%maxima_value)) deallocate(an%maxima_value)

    if (nmax > 0) then
        allocate(an%maxima_pix(nmax))
        allocate(an%maxima_value(nmax))
        an%maxima_pix   = pix
        an%maxima_value = values
    end if
end subroutine set_odf_analysis_maxima

