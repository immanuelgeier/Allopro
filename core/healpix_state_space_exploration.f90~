subroutine sample_odfs_C2( &
    odf_lib, &
    lifting_plan, &
    prefix_tra, &
    path_tra, &
    basis_index, &
    tau_mem, &
    dt,odf_name)

    implicit none

    type(odf_lib_type), intent(inout) :: odf_lib
    type(lifting_plan_type), intent(in) :: lifting_plan

    character(len=*), intent(in) :: prefix_tra
    character(len=*), intent(in) :: path_tra

    integer, intent(in) :: basis_index

    real(8), intent(in) :: tau_mem
    real(8), intent(in) :: dt

    character(len=2048) :: filename
    character(len=2048) :: path_and_prefix
    character(len=*) :: odf_name
    type(lifted_trajectory) :: raw_tra

    integer :: istate, irep, iblock
    integer :: iodf, ipix, iobj
    integer :: nframe, nobj
    integer :: t, tlag

    real(8) :: rot(3,3)
    real(8) :: vec_local(3)
    real(8) :: vec(3)
    real(8) :: lsq
    real(8) :: length

    real(8), allocatable :: rots(:,:,:)


    length = huge(length)

    path_and_prefix = trim(path_tra) // '/' // trim(prefix_tra)


    do istate = 1, size(lifting_plan%istates)
        do irep = 1, lifting_plan%nreps(istate)
            do iblock = 1, lifting_plan%nblock(istate,irep)

                call make_filename_lifted_tra( &
                    istate, irep, iblock, &
                    path_and_prefix, filename)

                write(0,*) trim(filename), ' in odf sampling'

                call read_trajectory(filename, raw_tra)

                write(0,*) &
                    lifting_plan%start_block(istate,irep,iblock), &
                    lifting_plan%end_block(istate,irep,iblock)

                nobj   = size(raw_tra%vec,2)
                nframe = size(raw_tra%vec,3)


                ! --------------------------------------------------------
                ! Geglättete Backbone-Basis einmal für diesen Block
                ! --------------------------------------------------------

                allocate(rots(3,3,nframe))

                call build_smoothed_backbone_basis( &
                    raw_tra, &
                    basis_index, &
                    tau_mem, &
                    dt, &
                    rots)


                ! --------------------------------------------------------
                ! Alle ODFs dieses Zustands
                ! --------------------------------------------------------

                do iodf = 1, odf_lib%n_odf

                    if (odf_lib%odf(iodf)%state /= &
                        lifting_plan%istates(istate)) cycle


                    do t = 1, nframe

                        tlag = t + odf_lib%odf(iodf)%lag

                        if (tlag > nframe) cycle


                        ! Basis bei Referenzzeit t
                        rot = rots(:,:,t)


                        do iobj = 1, size(odf_lib%odf(iodf)%hist,2)

                            ! Orientierung bei t + lag
                            vec = raw_tra%vec(:,iobj,tlag)

                            lsq = norm2(vec)

                            if (lsq == 0.0_8) cycle

                            length = min(sqrt(lsq),length)

                            vec = vec / sqrt(lsq)


                            ! In geglättete lokale Basis von t
                            vec_local = matmul(rot,vec)


                            ! HEALPix
                            call vec2pix_nest( &
                                odf_lib%odf(iodf)%nside, &
                                vec_local, &
                                ipix)


                            odf_lib%odf(iodf)%hist(ipix+1,iobj) = &
                                odf_lib%odf(iodf)%hist(ipix+1,iobj) + 1


                            ! C2-Symmetrie bei Bedarf:
                            !
                            ! if (odf_lib%c2_symmetry(iobj)) then
                            !
                            !     vec_local = -vec_local
                            !
                            !     call vec2pix_nest( &
                            !         odf_lib%odf(iodf)%nside, &
                            !         vec_local, &
                            !         ipix)
                            !
                            !     odf_lib%odf(iodf)%hist(ipix+1,iobj) = &
                            !         odf_lib%odf(iodf)%hist(ipix+1,iobj) + 1
                            !
                            ! end if

                        end do
                    end do

                end do


                write(0,*) 'max length', length

                deallocate(rots)

            end do
        end do
    end do


    write(0,*) 'final', length


    call write_odf_lib(odf_lib)
    call compute_odf_entropy_levels(odf_lib)
    call write_entropy(odf_lib)
    call write_odf_analysis_text(odf_lib)

end subroutine sample_odfs_C2





