    lifted%ntimes  = size(block%xyz, 3)
    lifted%nobject = nobject

    allocate(lifted%vec(3, 2*nobject, lifted%ntimes))
    lifted%vec = 0.d0

    allocate(counts(2*nobject))
    counts = 0


    !----------------------------------------
    ! Anzahl der Atome pro Objekt bestimmen
    !----------------------------------------

    do k = 1, size(plan%term)

        obj  = plan%term(k)%target
        comp = plan%term(k)%comp

        target_idx = 2*obj - (2-comp)

        counts(target_idx) = counts(target_idx) + 1

    end do


    !----------------------------------------
    ! occ berechnen 
    !----------------------------------------

    do t = 1, lifted%ntimes

        do k = 1, size(plan%term)

            atom = plan%term(k)%atom
            obj  = plan%term(k)%target
            comp = plan%term(k)%comp

            target_idx = 2*obj - (2-comp)

            !lifted%vec(:,target_idx,t) = &
            !    lifted%vec(:,target_idx,t) + &
            !    block%xyz(:,atom,t)
            	
           if(plan%object(obj)%object_type==1) occ(atom)=1.
           if(plan%object(obj)%object_type==2) occ(atom)=0.5
               
                

        end do
    end do


end subroutine lift_cv_plan_occ


end module position_lift_module
