module position_lift_module
    use time_window_file_mapping
    use time_window_loader
    use direction_vectors_analyse_plan_module
   
    
    implicit none
    private
    public :: lifted_trajectory, lift_cv_plan,lift_cv_plan_centroid,lift_cv_plan_occ,lift_cv_plan_all

    type :: lifted_trajectory
        integer :: nobject
        integer :: ntimes
        ! Dimensionen: (3, 2 * nobject, ntimes)
        ! Die 2. Dimension liegt abwechselnd im Speicher:
        ! 2*obj - 1  -> b1 (comp=1)
        ! 2*obj      -> b2 (comp=2)
        real(8), allocatable :: vec(:,:,:)
        real(8), allocatable :: centroid(:,:,:)
        !real(8), allocatable :: rot_matrix(:,:,:)
    end type lifted_trajectory

contains

subroutine lift_cv_plan_all(plan, block, lifted, centroid)

    implicit none

    type(cv_plan), intent(in)              :: plan
    type(raw_data_block), intent(in)       :: block
    type(lifted_trajectory), intent(out)   :: lifted
    type(lifted_trajectory), intent(out)   :: centroid

    integer :: nobject
    integer :: ntimes
    integer :: ntarget
    integer :: nterm

    integer :: t, k
    integer :: obj, comp, atom, target_idx

    integer, allocatable :: counts(:)

    real(8) :: xyz(3)

    nobject = size(plan%object)
    ntimes  = size(block%xyz, 3)
    nterm   = size(plan%term)
    ntarget = 2*nobject

    ! ------------------------------------------------------------
    ! Dimensionen
    ! ------------------------------------------------------------

    lifted%ntimes   = ntimes
    lifted%nobject  = nobject

    centroid%ntimes  = ntimes
    centroid%nobject = nobject

    ! ------------------------------------------------------------
    ! Speicher
    ! ------------------------------------------------------------

    allocate(lifted%vec(3, ntarget, ntimes))
    allocate(centroid%vec(3, ntarget, ntimes))

    lifted%vec   = 0.d0
    centroid%vec = 0.d0

    allocate(counts(ntarget))
    counts = 0

    ! ------------------------------------------------------------
    ! Anzahl Atome pro Objekt bestimmen
    ! ------------------------------------------------------------

    do k = 1, nterm

        obj  = plan%term(k)%target
        comp = plan%term(k)%comp

        target_idx = 2*obj - (2-comp)

        counts(target_idx) = counts(target_idx) + 1

    end do

    ! ------------------------------------------------------------
    ! Gemeinsamer Durchlauf
    ! ------------------------------------------------------------

    do t = 1, ntimes

        do k = 1, nterm

            atom = plan%term(k)%atom
            obj  = plan%term(k)%target
            comp = plan%term(k)%comp

            target_idx = 2*obj - (2-comp)

            ! Position nur einmal aus dem Array holen
            xyz = block%xyz(:, atom, t)

            ! Gewichtete Summe
            lifted%vec(:, target_idx, t) = &
                lifted%vec(:, target_idx, t) + &
                xyz * plan%term(k)%coeff

            ! Ungewichtete Summe
            centroid%vec(:, target_idx, t) = &
                centroid%vec(:, target_idx, t) + xyz

        end do

    end do

    ! ------------------------------------------------------------
    ! Alle Centroids nachträglich normieren
    !
    ! Keine t-Schleife mehr.
    ! ------------------------------------------------------------

    do target_idx = 1, ntarget

        if (counts(target_idx) > 0) then

            centroid%vec(:, target_idx, :) = &
                centroid%vec(:, target_idx, :) / &
                dble(counts(target_idx))

        endif

    end do

    deallocate(counts)

end subroutine lift_cv_plan_all

    subroutine lift_cv_plan(plan, block, lifted)
        type(cv_plan), intent(in)              :: plan
        type(raw_data_block), intent(in)       :: block
        type(lifted_trajectory), intent(out)   :: lifted

        integer :: nobject
        integer :: t, k, obj, comp, atom, target_idx

        nobject = size(plan%object)
        lifted%ntimes = size(block%xyz, 3)
        lifted%nobject = nobject

        ! 2. Dimension verdoppelt für das verschachtelte (interleaved) Layout
        allocate(lifted%vec(3, 2 * nobject, lifted%ntimes))
        lifted%vec = 0.d0

        ! ----------------------------------------
        ! Frames & CV Akkumulation
        ! ----------------------------------------
        do t = 1, lifted%ntimes
            do k = 1, size(plan%term)
                atom = plan%term(k)%atom
                obj  = plan%term(k)%target
                comp = plan%term(k)%comp ! 1 für b1, 2 für b2

                ! Mathematisch exakte Verschachtelung:
                ! Wenn comp = 1 (b1) -> 2 * obj - 1
                ! Wenn comp = 2 (b2) -> 2 * obj
                target_idx = 2 * obj - (2 - comp)

                lifted%vec(:, target_idx, t) = &
                    lifted%vec(:, target_idx, t) + &
                    block%xyz(:, atom, t) * plan%term(k)%coeff
            end do
        end do
        
        !! Rotationsmatrix-Speicher vorbereiten (3x3 pro Zeitschritt)
        !allocate(lifted%rot_matrix(3, 3, lifted%ntimes))
        !lifted%rot_matrix = 0.d0

    end subroutine lift_cv_plan
    
subroutine lift_cv_plan_centroid(plan, block, lifted)
    type(cv_plan), intent(in)            :: plan
    type(raw_data_block), intent(in)     :: block
    type(lifted_trajectory), intent(out) :: lifted
    integer :: nobject
    integer :: t, k
    integer :: obj, comp, atom, target_idx
    integer :: nterm
    integer, allocatable :: counts(:)
    nobject = size(plan%object)
    lifted%ntimes  = size(block%xyz, 3)
    lifted%nobject = nobject
    allocate(lifted%vec(3, 2*nobject, lifted%ntimes))
    lifted%vec = 0.d0
    allocate(counts(2*nobject))
    counts = 0
    !----------------------------------------
    ! Anzahl der Atome pro Objekt bestimmen
    !----------------------------------------
    do k = 1, size(plan%term)
        obj  = plan%term(k)%target
        comp = plan%term(k)%comp
        target_idx = 2*obj - (2-comp)
        counts(target_idx) = counts(target_idx) + 1
    end do
    !----------------------------------------
    ! Centroids berechnen
    !----------------------------------------
    do t = 1, lifted%ntimes
        do k = 1, size(plan%term)
            atom = plan%term(k)%atom
            obj  = plan%term(k)%target
            comp = plan%term(k)%comp
            target_idx = 2*obj - (2-comp)
            lifted%vec(:,target_idx,t) = &
                lifted%vec(:,target_idx,t) + &
                block%xyz(:,atom,t)
        end do
        ! Durch Anzahl der Atome des jeweiligen Objekts teilen
        do target_idx = 1, 2*nobject
            if (counts(target_idx) > 0) then
                lifted%vec(:,target_idx,t) = &
                    lifted%vec(:,target_idx,t) / &
                    dble(counts(target_idx))

            end if
        end do
    end do
    deallocate(counts)

end subroutine lift_cv_plan_centroid

