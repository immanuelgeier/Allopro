subroutine direction_vecs_ref_inv(n,ref,d1,d2_orig,cvec)
implicit none

integer,intent(in) :: n
real(8),intent(in) :: d1(3),d2_orig(3)
real(8)            :: d2(3)
real(8),allocatable,intent(in)  :: ref(:,:)
real(8),allocatable,intent(inout) :: cvec(:,:)

real(8) :: cog(3), ri(3)
real(8) :: c(n), c2(n)
real(8) :: v1(3), v2(3)

real(8) :: G(3,3)
real(8) :: U(3,3), VT(3,3), S(3)
real(8) :: work(100)

real(8) :: x1(3), x2(3)
real(8) :: tmp1(3), tmp2(3)

integer :: info, lwork, i, j

!orthogonalisation of d2
d2=d2_orig
d2=d2-dot_product(d1,d2)/dot_product(d1,d1)*d1
if(allocated(cvec)) deallocate(cvec)
allocate( cvec(2,n))
! ----------------------------------------
! CENTROID
! ----------------------------------------
cog = sum(ref,2) / dble(n)

! ----------------------------------------
! GYRATION TENSOR
! ----------------------------------------
G = 0.d0

do i=1,n
   ri = ref(:,i) - cog
   do j=1,3
      G(j,1) = G(j,1) + ri(j)*ri(1)
      G(j,2) = G(j,2) + ri(j)*ri(2)
      G(j,3) = G(j,3) + ri(j)*ri(3)
   end do
end do

! ----------------------------------------
! SVD
! ----------------------------------------
lwork = 100
call dgesvd('A','A',3,3,G,3,S,U,3,VT,3,work,lwork,info)

if (info /= 0) then
   write(0,*) 'DGESVD failed, info=',info
   stop
end if

! ----------------------------------------
! build x = V S^-1 U^T d
! ----------------------------------------

! U^T d
tmp1 = matmul(transpose(U), d1)
tmp2 = matmul(transpose(U), d2)

! S^-1
do i=1,3
   if (S(i) > 1d-12) then
      tmp1(i) = tmp1(i) / S(i)
      tmp2(i) = tmp2(i) / S(i)
   else
      tmp1(i) = 0.d0
      tmp2(i) = 0.d0
   end if
end do

! V = VT^T
x1 = matmul(transpose(VT), tmp1)
x2 = matmul(transpose(VT), tmp2)

! ----------------------------------------
! PROJECT ON ATOMS
! ----------------------------------------
do i=1,n
   ri = ref(:,i) - cog

   c(i)  = dot_product(ri, x1)
   c2(i) = dot_product(ri, x2)
end do

! ----------------------------------------
! CENTERING
! ----------------------------------------
c  = c  - sum(c)/dble(n)
c2 = c2 - sum(c2)/dble(n)



! ----------------------------------------
! RECONSTRUCTION CHECK
! ----------------------------------------
v1 = 0.d0
v2 = 0.d0

do i=1,n
   ri = ref(:,i) - cog
   v1 = v1 + c(i)*ri
   v2 = v2 + c2(i)*ri
end do

c=c/sqrt(dot_product(v1,v1))
c2=c2/sqrt(dot_product(v2,v2))

v1 = 0.d0
v2 = 0.d0

do i=1,n
   ri = ref(:,i) - cog
   v1 = v1 + c(i)*ri
   v2 = v2 + c2(i)*ri
end do

write(0,*) 'v1',v1,dot_product(v1,v1)
write(0,*) 'v2',v2,dot_product(v2,v2)

write(0,*) 'd1',d1/sqrt(dot_product(d1,d1))
write(0,*) 'd2',d2/sqrt(dot_product(d2,d2))

write(0,*) dot_product(d1/sqrt(dot_product(d1,d1)),v1)
write(0,*) dot_product(d2/sqrt(dot_product(d2,d2)),v2)

write(0,*),'dot(v1,v2)',dot_product(v1,v2),n,S
!pause      
!write(0,*) 'c1',c
!write(0,*) 'c2',c2

!pause

! ----------------------------------------
! OUTPUT
! ----------------------------------------
do i=1,n
   cvec(1,i) = c(i)
   cvec(2,i) = c2(i)
end do

end subroutine


subroutine direction_vecs_ref(n,ref,d1,d2,cvec)
real(8),intent(in) :: d1(3),d2(3)
real(8), allocatable,intent(in)  :: ref(:,:)
real(8), allocatable,intent(out) :: cvec(:,:)
real(8) :: cog(3),c(n),c2(n),ri(3)
real(8) :: v1(3), v2(3)

cog=sum(ref,2)
allocate( cvec(2,n))
cog = cog / dble(n)

  do i=1,n
     ri = ref(:,i) - cog
     c(i)  = dot_product(ri, d1)
     c2(i) = dot_product(ri, d2)
     !write(0,*) c(i),c2(i),'c raw',ri
  end do
    !write(0,*) d2,'d2'
  ! =========================================
  ! CENTERING
  ! =========================================
  !write(0,*) c,'c'
  !write(0,*) c2,'c2'
  c  = c  - sum(c)/dble(n)
  c2 = c2 - sum(c2)/dble(n)
  !write(0,*) dot_product(c,c2),'dot_product(c,c2)'

  ! =========================================
  ! NORMALIZATION (RECONSTRUCTION SPACE)
  ! =========================================
  v1 = 0.0d0
  v2 = 0.0d0

  do i=1,n
     ri = ref(:,i)! - cog
     v1 = v1 + c(i)*ri
     v2 = v2 + c2(i)*ri
  end do
  !write(0,*) 'v1 raw',v1
  !write(0,*) 'v2 raw',v2
 ! write(0,*)'dot(v1,d1)',dot_product(v1,d1),'dot(v2,d2)',dot_product(v2,d2)
  norm_c  = sqrt(dot_product(v1,v1))
  norm_c2 = sqrt(dot_product(v2,v2))
  
  if (norm_c  > 1d-12) c  = c  / norm_c
  if (norm_c2 > 1d-12) c2 = c2 / norm_c2
  
  v1 = 0.d0
  v2 = 0.d0
   do i=1,n
     ri = ref(:,i)! - cog
     v1 = v1 + c(i)*ri
     v2 = v2 + c2(i)*ri
  end do
  !write(0,*) 'v1',v1
  !write(0,*) 'v2',v2
  !write(0,*) 'v1/d1',v1/d1
  !write(0,*) 'v2/d2',v2/d2
  !write(0,*)'dot(v1,d1)',dot_product(v1,d1/dot_product(d1,d1))&
   !        ,'dot(v2,d2)',dot_product(v2,d2/dot_product(d2,d2))
  ! =========================================
  ! BUILD OPERATORS
  ! =========================================
  stop
  do i=1,n
     cvec(1,i) = c(i)
     cvec(2,i) = c2(i)
    
     !write(0,*) c(i),c2(i),'c'
  end do


end subroutine

        
                   

subroutine invert3x3(A)
implicit none

real(8),intent(inout) :: A(3,3)

real(8) :: Awork(3,3)
integer :: ipiv(3)
integer :: info
real(8) :: one(3,3)
integer :: i

! ----------------------------------------
! COPY MATRIX (because LAPACK overwrites RHS)
! ----------------------------------------
Awork = A

! ----------------------------------------
! INITIALIZE IDENTITY MATRIX
! ----------------------------------------
one = 0.d0
do i=1,3
   one(i,i) = 1.d0
end do

! ----------------------------------------
! SOLVE A * X = I  → X = A^{-1}
! ----------------------------------------
call dgesv(3, 3, Awork, 3, ipiv, one, 3, info)

if (info /= 0) then
   write(0,*) 'ERROR in invert3x3: DGESV failed, info =', info
   stop
end if

! ----------------------------------------
! RESULT: inverse is stored in I
! ----------------------------------------
A = I

end subroutine invert3x3










