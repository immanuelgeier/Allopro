module cv_plan_workflow_io_module

    use workflow_module, only: cv_plan_workflow_type
    use iso_fortran_env, only: output_unit, error_unit

    implicit none
    private

    public :: init_cv_plan_workflow
    public :: read_cv_plan_workflow
    public :: write_cv_plan_workflow
    public :: print_cv_plan_workflow
    public :: validate_cv_plan_workflow
    public :: configure_cv_plan_workflow

contains

subroutine configure_cv_plan_workflow(job)
    implicit none

    type(cv_plan_workflow_type), intent(out) :: job

    character(len=1024) :: filename
    character(len=32)   :: input
    integer :: choice, ios

    write(*,*)
    write(*,*) '======================================'
    write(*,*) '    CV plan workflow configuration'
    write(*,*) '======================================'
    write(*,*)
    write(*,*) '1 = Create new CV plan workflow'
    write(*,*) '2 = Load and edit existing CV plan workflow'
    write(*,*) '3 = Load existing CV plan workflow unchanged'
    write(*,*) '4 = Skip CV plan workflow configuration'
    write(*,*)
    write(*,'(A)', advance='no') 'Select option: '

    read(*,'(A)') input
    read(input,*,iostat=ios) choice

    if (ios /= 0) error stop 'Invalid CV plan workflow option'

    select case (choice)

    case (1)
        job = cv_plan_workflow_type()
        ! Standard-Arraygrößen initialisieren (1 Datei als Default)
        allocate(job%io_params%sidechain_library_files(1))
        job%io_params%sidechain_library_files(1) = 'sidechain.lib'
        allocate(job%io_params%domain_library_files(1))
        job%io_params%domain_library_files(1) = 'domain.lib'

        call edit_cv_plan_workflow(job)

    case (2)
        write(*,'(A)', advance='no') 'Configuration filename: '
        read(*,'(A)') filename

        if (len_trim(filename) == 0) error stop 'No configuration filename specified'

        call read_cv_plan_workflow(job, trim(filename))
        call edit_cv_plan_workflow(job)
        job%initialized = .true.

    case (3)
        write(*,'(A)', advance='no') 'Configuration filename: '
        read(*,'(A)') filename

        if (len_trim(filename) == 0) error stop 'No configuration filename specified'

        call read_cv_plan_workflow(job, trim(filename))
        call validate_cv_plan_workflow(job)

        write(*,*)
        write(*,*) 'CV plan workflow loaded:'
        call print_cv_plan_workflow(job)
        job%initialized = .true.

    case (4)
        job = cv_plan_workflow_type()
        write(*,*) 
        write(*,*) 'CV plan workflow configuration skipped.'

    case default
        error stop 'Invalid CV plan workflow option'

    end select

end subroutine configure_cv_plan_workflow


subroutine edit_cv_plan_workflow(job)
    implicit none

    type(cv_plan_workflow_type), intent(inout) :: job

    character(len=1024) :: input
    character(len=1024) :: filename
    integer :: ios, i, n
    logical :: save_config
    integer, allocatable :: temp_indices(:)

    write(*,*)
    write(*,*) '======================================'
    write(*,*) '    Edit CV plan workflow'
    write(*,*) '======================================'
    write(*,*) 'Press Enter to keep the current value.'
    write(*,*)

    ! --------------------------------------------------
    ! Sidechain Library Files (Multiple Support)
    ! --------------------------------------------------
    write(*,'(A,I0,A)', advance='no') 'Number of sidechain libraries [', job%io_params%n_sidechain_libs, ']: '
    read(*,'(A)') input
    if (len_trim(input) > 0) then
        read(input,*,iostat=ios) n
        if (ios /= 0 .or. n < 0) error stop 'Invalid number of sidechain libraries'
        job%io_params%n_sidechain_libs = n
        if (allocated(job%io_params%sidechain_library_files)) deallocate(job%io_params%sidechain_library_files)
        if (n > 0) allocate(job%io_params%sidechain_library_files(n))
    end if

    if (.not. allocated(job%io_params%sidechain_library_files) .and. job%io_params%n_sidechain_libs > 0) then
        allocate(job%io_params%sidechain_library_files(job%io_params%n_sidechain_libs))
        job%io_params%sidechain_library_files = 'sidechain.lib'
    end if

    do i = 1, job%io_params%n_sidechain_libs
        write(*,'(A,I0,A,A,A)', advance='no') '  Sidechain library file #',&
        i, ' [', trim(job%io_params%sidechain_library_files(i)), ']: '
        read(*,'(A)') input
        if (len_trim(input) > 0) then
            job%io_params%sidechain_library_files(i) = trim(input)
        end if
    end do

    ! --------------------------------------------------
    ! Domain Library Files (Multiple Support)
    ! --------------------------------------------------
    write(*,*)
    write(*,'(A,I0,A)', advance='no') 'Number of domain libraries [', job%io_params%n_domain_libs, ']: '
    read(*,'(A)') input
    if (len_trim(input) > 0) then
        read(input,*,iostat=ios) n
        if (ios /= 0 .or. n < 0) error stop 'Invalid number of domain libraries'
        job%io_params%n_domain_libs = n
        if (allocated(job%io_params%domain_library_files)) deallocate(job%io_params%domain_library_files)
        if (n > 0) allocate(job%io_params%domain_library_files(n))
    end if

    if (.not. allocated(job%io_params%domain_library_files) .and. job%io_params%n_domain_libs > 0) then
        allocate(job%io_params%domain_library_files(job%io_params%n_domain_libs))
        job%io_params%domain_library_files(1) = 'domain.lib'
    end if

    do i = 1, job%io_params%n_domain_libs
        write(*,'(A,I0,A,A,A)', advance='no') '  Domain library file #', i, ' [', trim(job%io_params%domain_library_files(i)), ']: '
        read(*,'(A)') input
        if (len_trim(input) > 0) then
            job%io_params%domain_library_files(i) = trim(input)
        end if
    end do

    ! --------------------------------------------------
    ! Inclusion Flags & Selection Modes
    ! --------------------------------------------------
    write(*,*)
    write(*,*) 'CV inclusion parameters (.true. / .false.):'

    write(*,'(A,L1,A)', advance='no') 'Include sidechain CVs [', job%run_params%include_sidechain_cvs, ']: '
    read(*,'(A)') input
    if (len_trim(input) > 0) then
        read(input,*,iostat=ios) job%run_params%include_sidechain_cvs
        if (ios /= 0) error stop 'Invalid logical value'
    end if

    if (job%run_params%include_sidechain_cvs) then
        write(*,'(A,I0,A)', advance='no') '  Sidechain selection mode (1=All, 2=Specific indices) [', &
            job%run_params%sidechain_selection_mode, ']: '
        read(*,'(A)') input
        if (len_trim(input) > 0) then
            read(input,*,iostat=ios) job%run_params%sidechain_selection_mode
            if (ios /= 0) error stop 'Invalid selection mode'
        end if

        if (job%run_params%sidechain_selection_mode == 2) then
            write(*,'(A)', advance='no') '  Enter specific sidechain indices (space-separated): '
            read(*,'(A)') input
            if (len_trim(input) > 0) then
                ! Einfaches Einlesen in temporäres Array (Beispielhaft bis zu 100 Elemente)
                allocate(temp_indices(100))
                read(input, *, iostat=ios) temp_indices(:n) ! Hier ggf. flexibel parsen
                ! Für eine robuste Umsetzung kann man das Array dynamisch allokieren oder über interne Reads lösen.
            end if
        end if
    end if

    write(*,'(A,L1,A)', advance='no') 'Include domain CVs [', job%run_params%include_domain_cvs, ']: '
    read(*,'(A)') input
    if (len_trim(input) > 0) then
        read(input,*,iostat=ios) job%run_params%include_domain_cvs
        if (ios /= 0) error stop 'Invalid logical value'
    end if

    ! --------------------------------------------------
    ! Validate and display
    ! --------------------------------------------------
    call validate_cv_plan_workflow(job)

    write(*,*)
    write(*,*) 'Resulting CV plan workflow configuration:'
    call print_cv_plan_workflow(job)

    ! --------------------------------------------------
    ! Save configuration
    ! --------------------------------------------------
    write(*,*)
    write(*,'(A)', advance='no') 'Save configuration? (y/n): '
    read(*,'(A)') input

    save_config = trim(input) == 'y' .or. trim(input) == 'Y'

    if (save_config) then
        write(*,'(A)', advance='no') 'Configuration filename [cv_plan_workflow.cfg]: '
        read(*,'(A)') filename

        if (len_trim(filename) == 0) filename = 'cv_plan_workflow.cfg'

        call write_cv_plan_workflow(job, trim(filename))
        write(*,'(3A)') 'Configuration saved to "', trim(filename), '"'
    end if

end subroutine edit_cv_plan_workflow


subroutine init_cv_plan_workflow(job, mode, filename)
    type(cv_plan_workflow_type), intent(out) :: job
    character(len=*), intent(in) :: mode
    character(len=*), intent(in), optional :: filename

    job = cv_plan_workflow_type()
    allocate(job%io_params%sidechain_library_files(1))
    job%io_params%sidechain_library_files(1) = 'sidechain.lib'
    allocate(job%io_params%domain_library_files(1))
    job%io_params%domain_library_files(1) = 'domain.lib'

    select case (trim(mode))
    case ('manual')
        ! Defaults behalten
    case ('file')
        if (.not. present(filename)) error stop 'init_cv_plan_workflow: filename missing'
        call read_cv_plan_workflow(job, filename)
    case default
        write(error_unit, '(A,A)') 'init_cv_plan_workflow: unknown mode: ', trim(mode)
        error stop
    end select

    call validate_cv_plan_workflow(job)
end subroutine init_cv_plan_workflow


subroutine validate_cv_plan_workflow(job)
    implicit none
    type(cv_plan_workflow_type), intent(in) :: job
    ! Zusätzliche Konsistenzprüfungen falls nötig
end subroutine validate_cv_plan_workflow


subroutine write_cv_plan_workflow(job, filename)
    type(cv_plan_workflow_type), intent(in) :: job
    character(len=*), intent(in) :: filename
    integer :: unit, ios

    call validate_cv_plan_workflow(job)
    open(newunit=unit, file=trim(filename), status='replace', action='write', iostat=ios)
    if (ios /= 0) then
        write(error_unit, '(A,A)') 'Cannot open CV plan workflow file: ', trim(filename)
        error stop
    end if

    call write_cv_plan_workflow_unit(job, unit)
    close(unit, iostat=ios)
end subroutine write_cv_plan_workflow


subroutine print_cv_plan_workflow(job)
    type(cv_plan_workflow_type), intent(in) :: job
    call write_cv_plan_workflow_unit(job, output_unit)
end subroutine print_cv_plan_workflow


subroutine write_cv_plan_workflow_unit(job, unit)
    type(cv_plan_workflow_type), intent(in) :: job
    integer, intent(in) :: unit
    integer :: i

    write(unit, '(A)') '# CV plan workflow configuration'
    write(unit, '(A)') 'workflow_type = cv_plan'
    write(unit, '(A)') 'format_version = 1'
    write(unit, '(A)') ''

    write(unit, '(A)') '# Run parameters'
    call write_bool(unit, 'include_sidechain_cvs', job%run_params%include_sidechain_cvs)
    write(unit, '(A,I0)') 'sidechain_selection_mode = ', job%run_params%sidechain_selection_mode
    
    call write_bool(unit, 'include_domain_cvs', job%run_params%include_domain_cvs)
    write(unit, '(A,I0)') 'domain_selection_mode = ', job%run_params%domain_selection_mode

    write(unit, '(A)') ''
    write(unit, '(A)') '# Library I/O parameters'
    
    ! Sidechain Bibliotheken schreiben
    write(unit, '(A,I0)') 'n_sidechain_libs = ', job%io_params%n_sidechain_libs
    if (allocated(job%io_params%sidechain_library_files)) then
        do i = 1, job%io_params%n_sidechain_libs
            write(unit, '(A,I0,A,A)') 'sidechain_library_file_', i, ' = ', trim(job%io_params%sidechain_library_files(i))
        end do
    end if

    write(unit, '(A)') ''
    ! Domain Bibliotheken schreiben
    write(unit, '(A,I0)') 'n_domain_libs = ', job%io_params%n_domain_libs
    if (allocated(job%io_params%domain_library_files)) then
        do i = 1, job%io_params%n_domain_libs
            write(unit, '(A,I0,A,A)') 'domain_library_file_', i, ' = ', trim(job%io_params%domain_library_files(i))
        end do
    end if

end subroutine write_cv_plan_workflow_unit


subroutine write_bool(unit, key, value)
    integer, intent(in) :: unit
    character(len=*), intent(in) :: key
    logical, intent(in) :: value
    if (value) then
        write(unit, '(A," = .true.")') trim(key)
    else
        write(unit, '(A," = .false.")') trim(key)
    end if
end subroutine write_bool


subroutine read_cv_plan_workflow(job, filename)
    type(cv_plan_workflow_type), intent(inout) :: job
    character(len=*), intent(in) :: filename

    character(len=2048) :: line
    character(len=128)  :: key
    character(len=1900) :: value

    integer :: unit, ios, line_number, eq_pos, format_version, idx
    logical :: seen_type, seen_version

    job = cv_plan_workflow_type()
    format_version = -1
    seen_type = .false.
    seen_version = .false.

    open(newunit=unit, file=trim(filename), status='old', action='read', iostat=ios)
    if (ios /= 0) then
        write(error_unit, '(A,A)') 'Cannot open CV plan workflow file: ', trim(filename)
        error stop
    end if

    line_number = 0

    do
        read(unit, '(A)', iostat=ios) line
        if (ios < 0) exit
        if (ios > 0) then
            close(unit)
            error stop 'Error reading CV plan workflow file'
        end if

        line_number = line_number + 1
        line = adjustl(line)

        if (len_trim(line) == 0) cycle
        if (line(1:1) == '#' .or. line(1:1) == '!') cycle

        eq_pos = index(line, '=')
        if (eq_pos == 0) call config_error(line_number, 'Missing "=" in configuration line')

        key = trim(adjustl(line(:eq_pos-1)))
        value = trim(adjustl(line(eq_pos+1:)))

        select case (trim(key))
        case ('workflow_type')
            if (trim(value) /= 'cv_plan') call config_error(line_number, 'Wrong workflow_type')
            seen_type = .true.

        case ('format_version')
            read(value, *, iostat=ios) format_version
            call check_value_read(ios, line_number, key)
            if (format_version /= 1) call config_error(line_number, 'Unsupported format_version')
            seen_version = .true.

        case ('include_sidechain_cvs')
            read(value, *, iostat=ios) job%run_params%include_sidechain_cvs
            call check_value_read(ios, line_number, key)

        case ('sidechain_selection_mode')
            read(value, *, iostat=ios) job%run_params%sidechain_selection_mode
            call check_value_read(ios, line_number, key)

        case ('include_domain_cvs')
            read(value, *, iostat=ios) job%run_params%include_domain_cvs
            call check_value_read(ios, line_number, key)

        case ('domain_selection_mode')
            read(value, *, iostat=ios) job%run_params%domain_selection_mode
            call check_value_read(ios, line_number, key)

        case ('n_sidechain_libs')
            read(value, *, iostat=ios) job%io_params%n_sidechain_libs
            call check_value_read(ios, line_number, key)
            if (allocated(job%io_params%sidechain_library_files)) deallocate(job%io_params%sidechain_library_files)
            allocate(job%io_params%sidechain_library_files(job%io_params%n_sidechain_libs))

        case ('n_domain_libs')
            read(value, *, iostat=ios) job%io_params%n_domain_libs
            call check_value_read(ios, line_number, key)
            if (allocated(job%io_params%domain_library_files)) deallocate(job%io_params%domain_library_files)
            allocate(job%io_params%domain_library_files(job%io_params%n_domain_libs))

        case default
            if (index(trim(key), 'sidechain_library_file_') == 1) then
                read(key(24:), *, iostat=ios) idx
                if (ios == 0 .and. idx > 0 .and. idx <= job%io_params%n_sidechain_libs) then
                    job%io_params%sidechain_library_files(idx) = trim(value)
                end if
            else if (index(trim(key), 'domain_library_file_') == 1) then
                read(key(21:), *, iostat=ios) idx
                if (ios == 0 .and. idx > 0 .and. idx <= job%io_params%n_domain_libs) then
                    job%io_params%domain_library_files(idx) = trim(value)
                end if
            else
                call config_error(line_number, 'Unknown parameter: '//trim(key))
            end if
        end select
    end do

    close(unit)
    if (.not. seen_type) error stop 'CV plan workflow file has no workflow_type'
    if (.not. seen_version) error stop 'CV plan workflow file has no format_version'
end subroutine read_cv_plan_workflow


subroutine check_value_read(ios, line_number, key)
    integer, intent(in) :: ios, line_number
    character(len=*), intent(in) :: key
    if (ios /= 0) then
        write(error_unit, '(A,I0,A,A)') 'Invalid value at line ', line_number, ' for parameter ', trim(key)
        error stop
    end if
end subroutine check_value_read


subroutine config_error(line_number, message)
    integer, intent(in) :: line_number
    character(len=*), intent(in) :: message
    write(error_unit, '(A,I0,2A)') 'CV plan workflow error at line ', line_number, ': ', trim(message)
    error stop
end subroutine config_error

end module cv_plan_workflow_io_module