            write(0,*) '     ndcd:',project%state(i)%rep(j)%ndcd
            do k=1,min(3,project%state(i)%rep(j)%ndcd)
                write(0,*) 'file:',trim(project%state(i)%rep(j)%dcd_files(k))
                
            end do
            write(0,*) '...'
